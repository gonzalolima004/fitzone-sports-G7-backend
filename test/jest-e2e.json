{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "@swc/jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(\\.pnpm|@nestjs|@scure|@noble|@otplib|otplib)/)"
  ],
  "moduleNameMapper": {
    "^@nestjs/config$": "<rootDir>/../node_modules/@nestjs/config"
  }
}
