# Server configuration
PORT=3000
NODE_ENV=development

# Database configuration (Supabase PostgreSQL)
DB_HOST=your-db-host.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=postgres

# Prisma Connection URL
DATABASE_URL="postgresql://postgres:your_database_password@your-db-host.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:your_database_password@your-db-host.supabase.co:5432/postgres"

# Supabase Storage (S3 Protocol)
S3_ENDPOINT="https://your-project-id.storage.supabase.co/storage/v1/s3"
S3_REGION="us-west-2"
S3_ACCESS_KEY_ID="your_s3_access_key_id"
S3_SECRET_ACCESS_KEY="your_s3_secret_access_key"
S3_BUCKET_NAME="fitzone-storage"


# Mercado Pago Configuration
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="mercadopago_webhook_secret"
BACK_URL_SUCCESS="http://localhost:3001/pagos/exito"
BACK_URL_FAILURE="http://localhost:3001/pagos/fallo"
BACK_URL_PENDING="http://localhost:3001/pagos/pendiente"
NOTIFICATION_URL="https://dominio.com/pagos/webhook"

